<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- A method with a loop is compiled fully on its first call instead of being swapped
         for an optimised version while its loop is running (on-stack replacement). That swap
         allocates on the running thread, and was measured landing about 1.5 KB inside a
         single execution of a student's statement — enough to bend a memory curve. The tests
         run with the same setting as the engine, so they measure what students get. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DsaViz.Engine/DsaViz.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied, not compiled: these are fixtures the engine compiles at runtime. -->
    <None Include="../../samples/**/*.cs;../../samples/**/*.py" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
  </ItemGroup>
</Project>
