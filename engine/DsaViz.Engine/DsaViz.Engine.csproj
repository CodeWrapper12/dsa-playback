<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- A method with a loop is compiled fully on its first call instead of being swapped
         for an optimised version while its loop is running (on-stack replacement). That swap
         allocates on the running thread, and was measured landing about 1.5 KB inside a
         single execution of a student's statement — enough to bend a memory curve. The tests
         run with the same setting as the engine, so they measure what students get. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DsaViz.Engine</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Python runner ships beside the engine, in the build output and the published package. -->
    <None Include="python/*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The C++ runtime header is compiled into each C++ solution by the student's compiler. -->
    <None Include="cpp/*.hpp" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The Rust runtime is compiled by the student's rustc, once per Rust version. -->
    <None Include="rust/*.rs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The Java runtime is compiled by the student's javac, once per JDK. -->
    <None Include="java/*.java" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DsaViz.Runtime/DsaViz.Runtime.csproj" />
  </ItemGroup>
</Project>
